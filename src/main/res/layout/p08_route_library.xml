<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/p08_library_toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <TextView android:id="@+id/p08_library_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:accessibilityLiveRegion="polite" android:textSize="14sp" />
    <ProgressBar android:id="@+id/p08_library_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/p08_route_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="8dp" android:dividerHeight="1dp" />
        <TextView android:id="@+id/p08_library_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="@string/p08_library_empty" android:textSize="18sp" />
    </FrameLayout>
    <Button android:id="@+id/p08_library_import" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/p08_import_title" />
</LinearLayout>
