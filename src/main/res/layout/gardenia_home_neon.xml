<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <ScrollView android:id="@+id/p02_home_scroll" android:layout_width="match_parent" style="@style/P02HomeContent" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/p02_page_padding" android:paddingEnd="@dimen/p02_page_padding" android:paddingTop="8dp" android:paddingBottom="8dp" android:id="@+id/p03_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/p0_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/p0_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/p03_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:padding="0dp" android:contentDescription="@string/menu_settings" android:tooltipText="@string/menu_settings" app:icon="@drawable/ic_settings_24dp" app:iconSize="24dp" app:iconPadding="0dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/p0_all_history" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:padding="0dp" android:contentDescription="@string/p0_all_history" android:tooltipText="@string/p0_all_history" app:icon="@drawable/p02_history" app:iconSize="24dp" app:iconPadding="0dp" />
                </LinearLayout>
                <TextView android:id="@+id/p03_family_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:layout_marginBottom="8dp" />
                <RadioGroup android:id="@+id/p0_sport" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/p0_running" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/p0_running" android:checked="true" />
                    <RadioButton android:id="@+id/p0_cycling" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/p0_cycling" />
                </RadioGroup>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="?attr/gardeniaCornerRadius" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="?attr/gardeniaCardStroke" android:id="@+id/p03_heart_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:baselineAligned="false">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_heart_heading" android:textAppearance="?attr/textAppearanceLabelMedium" />
                                <TextView android:id="@+id/p0_heart_rate" android:layout_width="match_parent" android:layout_height="112dp" android:text="@string/hr_empty_value" style="@style/P02MetricValue" android:textColor="?attr/gardeniaAccentText" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="88sp" android:gravity="center_vertical" android:fontFamily="sans-serif-light" android:textStyle="normal" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                    <TextView android:id="@+id/p02_heart_device" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textStyle="bold" />
                                    <com.google.android.material.button.MaterialButton android:id="@+id/p0_devices" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:padding="0dp" android:contentDescription="@string/p0_devices" android:tooltipText="@string/p0_devices" app:icon="@drawable/ic_settings_24dp" app:iconSize="24dp" app:iconPadding="0dp" />
                                </LinearLayout>
                                <TextView android:id="@+id/p02_heart_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
                                <TextView android:id="@+id/p02_heart_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/p02_heart_reconnect" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                        <de.dennisguse.opentracks.chart.ChartView android:id="@+id/p03_heart_chart" android:layout_width="match_parent" android:layout_height="140dp" android:contentDescription="@string/gardenia_chart_empty" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="?attr/gardeniaCornerRadius" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:strokeWidth="?attr/gardeniaCardStroke" android:id="@+id/p03_state_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/p0_recording_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_idle" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" android:textColor="?attr/colorOnPrimaryContainer" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/p02_status_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/p02_idle_detail" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView android:id="@+id/p0_location_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnPrimaryContainer" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/p0_location_permission" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p0_enable_location" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/p0_location_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_location_settings" android:textColor="?attr/colorOnPrimaryContainer" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/p0_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="?attr/gardeniaCornerRadius" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="?attr/gardeniaCardStroke" android:id="@+id/p03_metric_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_distance" android:textAppearance="@style/P02MetricLabel" />
                                <TextView android:id="@+id/p02_distance_value" android:layout_width="match_parent" android:layout_height="48dp" style="@style/P02MetricValue" android:gravity="center_vertical" android:textColor="?attr/gardeniaAccentText" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_time" android:textAppearance="@style/P02MetricLabel" />
                                <TextView android:id="@+id/p02_time_value" android:layout_width="match_parent" android:layout_height="48dp" style="@style/P02MetricValue" android:gravity="center_vertical" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_speed" android:textAppearance="@style/P02MetricLabel" />
                                <TextView android:id="@+id/p02_speed_value" android:layout_width="match_parent" android:layout_height="36dp" style="@style/P02MetricValue" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="22sp" android:gravity="center_vertical" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_pace" android:textAppearance="@style/P02MetricLabel" />
                                <TextView android:id="@+id/p02_pace_value" android:layout_width="match_parent" android:layout_height="36dp" style="@style/P02MetricValue" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="22sp" android:gravity="center_vertical" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/p0_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/p0_notification_permission" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p0_enable_notification" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/p02_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="@dimen/p02_page_padding" android:paddingEnd="@dimen/p02_page_padding" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_start" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_cancel_gps" style="@style/P02SecondaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/p02_cancel_short" android:contentDescription="@string/p02_cancel_gps" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_continue_gps" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/p02_continue_gps" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_pause" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_pause" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_resume" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_resume" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/p0_finish" style="@style/P02SecondaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_finish" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>