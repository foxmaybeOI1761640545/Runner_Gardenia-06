<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/heart_rate_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:text="@string/hr_chart_empty" android:textAppearance="?attr/textAppearanceSubtitle1" />
    <TextView android:id="@+id/heart_rate_chart_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:text="@string/hr_chart_hint" android:textAppearance="?attr/textAppearanceCaption" />
    <de.dennisguse.opentracks.chart.ChartView android:id="@+id/chart_view" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
