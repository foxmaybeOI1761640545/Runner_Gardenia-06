<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:id="@+id/p02_home_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false">
      <LinearLayout android:id="@+id/p03_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="6dp">
          <TextView android:id="@+id/p0_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p04_brand" android:textSize="9sp" android:textAllCaps="true" android:letterSpacing="0.15" />
          <TextView android:id="@+id/p04_page_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Value" android:text="@string/p04_run" android:textSize="22sp" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/p05_compact_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
          <RadioGroup android:id="@+id/p0_sport" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <RadioButton android:id="@+id/p0_running" style="@style/P05SportChoice" android:text="@string/p05_running_short" android:contentDescription="@string/p0_running" android:checked="true" />
            <RadioButton android:id="@+id/p0_cycling" style="@style/P05SportChoice" android:text="@string/p05_cycling_short" android:contentDescription="@string/p0_cycling" />
          </RadioGroup>
          <com.google.android.material.button.MaterialButton android:id="@+id/p04_gps_status" style="@style/P05CompactStatus" android:text="@string/p05_gps_unavailable" app:icon="@drawable/p04_gps" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_devices" style="@style/P05CompactStatus" android:text="@string/p05_heart_disconnected" app:icon="@drawable/p04_bluetooth" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp">
          <de.dennisguse.opentracks.p0.app.RouteMapView android:id="@+id/p04_route" android:layout_width="match_parent" android:layout_height="238dp" android:contentDescription="@string/p04_route_empty" />
          <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="bottom|start" android:layout_margin="14dp" android:paddingHorizontal="12dp" android:background="@drawable/p04_map_readout">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_distance" android:letterSpacing="0.10" android:gravity="start" />
              <TextView android:id="@+id/p02_distance_value" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Value" android:textSize="46sp" android:gravity="start" android:textColor="?attr/gardeniaAccentText" android:layout_marginTop="6dp" android:fontFamily="sans-serif-condensed" />
            </LinearLayout>
          </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/p03_state_card" android:paddingTop="4dp" android:paddingBottom="4dp">
          <TextView android:id="@+id/p0_recording_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_idle" android:textColor="?attr/gardeniaAccentText" android:textSize="12sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
          <TextView android:id="@+id/p02_status_detail" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_idle_detail" android:textSize="11sp" android:layout_marginTop="3dp" />
          <TextView android:id="@+id/p0_location_status" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:visibility="gone" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_location_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p0_enable_location" android:visibility="gone" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_location_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p02_location_settings" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/p0_error" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/p03_metric_card" android:layout_marginBottom="4dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingHorizontal="10dp" android:paddingVertical="4dp">
              <TextView android:id="@+id/p02_time_value" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Value" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_time" android:layout_marginTop="5dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingHorizontal="10dp" android:paddingVertical="4dp">
              <TextView android:id="@+id/p02_pace_value" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Value" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_pace" android:layout_marginTop="5dp" />
              <TextView android:id="@+id/p02_speed_value" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:layout_marginTop="4dp" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingHorizontal="10dp" android:paddingVertical="4dp">
              <TextView android:id="@+id/p0_heart_rate" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Value" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p02_heart_heading" android:layout_marginTop="5dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:paddingVertical="3dp">
            <TextView android:id="@+id/p04_accuracy" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/P04Value" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p04_accuracy" android:layout_marginStart="8dp" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/p02_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_start" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_start" android:visibility="visible" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_cancel_gps" style="@style/P02SecondaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p02_cancel_short" android:visibility="gone" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_continue_gps" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p02_continue_gps" android:visibility="gone" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_pause" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="2" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_pause" android:visibility="gone" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_resume" style="@style/P02PrimaryAction" android:layout_width="0dp" android:layout_weight="2" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_resume" android:visibility="gone" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/p0_finish" style="@style/P02SecondaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginHorizontal="2dp" android:text="@string/p0_finish" android:visibility="gone" android:textSize="13sp" android:insetTop="4dp" android:insetBottom="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/p03_heart_card" android:padding="8dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:text="@string/p04_chart_recent" android:gravity="center" android:textSize="10sp" android:letterSpacing="0.10" />
          <de.dennisguse.opentracks.p0.app.PulseChartView android:id="@+id/p03_heart_chart" android:layout_width="match_parent" android:layout_height="84dp" android:layout_marginTop="10dp" android:contentDescription="@string/gardenia_chart_empty" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/p02_heart_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textSize="12sp" />
            <TextView android:id="@+id/p02_heart_device" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textSize="11sp" />
            <TextView android:id="@+id/p02_heart_updated" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textSize="10sp" />
            <TextView android:id="@+id/p02_heart_reconnect" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textSize="10sp" />
          </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/p0_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/P04Label" android:textSize="10sp" android:visibility="gone" android:layout_marginTop="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/p0_notification_permission" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/p0_enable_notification" android:visibility="gone" />
      </LinearLayout>
    </ScrollView>
    <include layout="@layout/p04_navigation" />
  </LinearLayout>
</FrameLayout>